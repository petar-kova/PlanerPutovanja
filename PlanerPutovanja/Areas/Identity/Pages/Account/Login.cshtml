@page
@model LoginModel

@{
    ViewData["Title"] = "Prijava";
}

<section class="auth-page">
    <div class="auth-shell">
        <div class="auth-visual">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
                PlanerPutovanja
            </a>

            <div class="auth-visual-content">
                <span class="eyebrow">Dobrodošao natrag</span>
                <h1>Nastavi planirati svoje putovanje</h1>
                <p>
                    Prijavi se i nastavi uređivati putovanja, destinacije, troškove, aktivnosti i planove koje si spremio.
                </p>

                <div class="auth-feature-list">
                    <div>
                        <strong>🧳 Putovanja</strong>
                        <span>Pregled svih spremljenih planova</span>
                    </div>

                    <div>
                        <strong>📍 Destinacije</strong>
                        <span>Dodavanje više lokacija u rutu</span>
                    </div>

                    <div>
                        <strong>💶 Budžet</strong>
                        <span>Praćenje troškova i potrošnje</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-card">
            <div class="auth-card-header">
                <span class="eyebrow">Prijava</span>
                <h2>Uđi u svoj račun</h2>
                <p>Unesi email i lozinku za nastavak planiranja.</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary mb-4" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email adresa</label>
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="ime@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Lozinka</label>
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Unesi lozinku" />
                    <span asp-validation-for="Input.Password" class="text-danger small fw-semibold"></span>
                </div>

                <div class="auth-row">
                    <label asp-for="Input.RememberMe" class="remember-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        Zapamti me
                    </label>
                </div>

                <button id="login-submit" type="submit" class="btn-main w-100">
                    Prijavi se
                </button>

                <div class="auth-bottom">
                    <span>Nemaš račun?</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                        Registriraj se
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}