@page
@model RegisterModel

@{
    ViewData["Title"] = "Registracija";
}

<section class="auth-page register-page">
    <div class="auth-shell">
        <div class="auth-visual">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
                PlanerPutovanja
            </a>

            <div class="auth-visual-content">
                <span class="eyebrow">Novi korisnik</span>
                <h1>Kreiraj račun i organiziraj putovanja pametnije</h1>
                <p>
                    Spremi svoje planove, dodaj više destinacija, prati troškove i imaj sve informacije na jednom mjestu.
                </p>

                <div class="auth-feature-list">
                    <div>
                        <strong>⚡ Brzo planiranje</strong>
                        <span>Dodaj putovanje u nekoliko koraka</span>
                    </div>

                    <div>
                        <strong>🗺️ Ruta</strong>
                        <span>Planiranje više destinacija</span>
                    </div>

                    <div>
                        <strong>📊 Dashboard</strong>
                        <span>Pregled statistike i budžeta</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-card">
            <div class="auth-card-header">
                <span class="eyebrow">Registracija</span>
                <h2>Kreiraj novi račun</h2>
                <p>Unesi email i lozinku kako bi mogao spremati svoja putovanja.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary mb-4" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email adresa</label>
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="ime@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Lozinka</label>
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Unesi lozinku" />
                    <span asp-validation-for="Input.Password" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Potvrdi lozinku</label>
                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Ponovi lozinku" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small fw-semibold"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn-main w-100">
                    Registriraj se
                </button>

                <div class="auth-bottom">
                    <span>Već imaš račun?</span>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                        Prijavi se
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}