@model PlanerPutovanja.Models.DashboardViewModel
@using System.Text.Json
@using System.Globalization
@using System.Linq
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Dashboard";

    var usageColorClass = "bg-danger";
    var usageTextClass = "text-danger";

    if (Model.BudgetUsagePercent < 70m)
    {
        usageColorClass = "bg-success";
        usageTextClass = "text-success";
    }
    else if (Model.BudgetUsagePercent <= 90m)
    {
        usageColorClass = "bg-warning";
        usageTextClass = "text-warning";
    }

    var widthValue = Math.Min(Model.BudgetUsagePercent, 100m)
        .ToString("0.##", CultureInfo.InvariantCulture);
    var usageWidth = widthValue + "%";

    var monthlyLabelsJson = JsonSerializer.Serialize(Model.MonthlyExpenses.Select(x => x.Label).ToList());
    var monthlyTotalsJson = JsonSerializer.Serialize(Model.MonthlyExpenses.Select(x => x.Total).ToList());

    var destinationLabelsJson = JsonSerializer.Serialize(Model.TopDestinations.Select(x => x.City).ToList());
    var destinationCountsJson = JsonSerializer.Serialize(Model.TopDestinations.Select(x => x.Count).ToList());
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h2 mb-0">Dashboard</h1>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary">Refresh</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted text-uppercase small fw-semibold">Total trips</span>
                    <span aria-hidden="true">🧳</span>
                </div>
                <div class="display-6 fw-bold">@Model.TotalTrips</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted text-uppercase small fw-semibold">Total expenses</span>
                    <span aria-hidden="true">💸</span>
                </div>
                <div class="display-6 fw-bold">@Model.TotalExpenses.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted text-uppercase small fw-semibold">Total budget</span>
                    <span aria-hidden="true">💰</span>
                </div>
                <div class="display-6 fw-bold">@Model.TotalBudget.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted text-uppercase small fw-semibold">Budget usage</span>
                    <span aria-hidden="true">📊</span>
                </div>

                <div class="display-6 fw-bold @usageTextClass">
                    @Model.BudgetUsagePercent.ToString("0.##")%
                </div>

                <div class="progress mt-3" role="progressbar"
                     aria-label="Budget usage"
                     aria-valuenow="@Model.BudgetUsagePercent"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <div class="progress-bar @usageColorClass" style="width: @usageWidth"></div>
                </div>

                <div class="small text-muted mt-2">
                    @Model.TotalExpenses.ToString("N2") / @Model.TotalBudget.ToString("N2")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Top expenses by trip</h2>
                <div style="height:260px;">
                    <canvas id="monthlyExpensesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Top destinations</h2>
                <div style="height:260px;">
                    <canvas id="topDestinationsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Upcoming trips</h2>

                @if (Model.UpcomingTrips == null || Model.UpcomingTrips.Count == 0)
                {
                    <p class="text-muted mb-0">No upcoming trips yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Trip</th>
                                    <th>Destination</th>
                                    <th>Dates</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trip in Model.UpcomingTrips)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Trips"
                                               asp-action="Details"
                                               asp-route-id="@trip.TripId"
                                               class="text-decoration-none fw-semibold">
                                                @trip.Name
                                            </a>
                                        </td>
                                        <td>@trip.Destination</td>
                                        <td>@trip.StartDate.ToString("dd MMM yyyy") - @trip.EndDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Over budget / Warning</h2>

                @if (Model.OverBudgetTrips == null || Model.OverBudgetTrips.Count == 0)
                {
                    <p class="text-muted mb-0">Great! No trips above 90% budget usage.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var trip in Model.OverBudgetTrips)
                        {
                            var badgeClass = trip.UsagePercent >= 100m ? "bg-danger" : "bg-warning text-dark";
                            var badgeText = trip.UsagePercent >= 100m ? "Over budget" : "Warning";

                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <a asp-controller="Trips"
                                           asp-action="Details"
                                           asp-route-id="@trip.TripId"
                                           class="fw-semibold text-decoration-none">
                                            @trip.Name
                                        </a>
                                        <div class="small text-muted">
                                            @trip.Expenses.ToString("N2") / @trip.Budget.ToString("N2")
                                        </div>
                                    </div>
                                    <span class="badge @badgeClass">
                                        @badgeText (@trip.UsagePercent.ToString("0.#")%)
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
               const monthlyLabels = JSON.parse('@JavaScriptEncoder.Default.Encode(monthlyLabelsJson)');
        const monthlyTotals = JSON.parse('@JavaScriptEncoder.Default.Encode(monthlyTotalsJson)');
        const destinationLabels = JSON.parse('@JavaScriptEncoder.Default.Encode(destinationLabelsJson)');
        const destinationCounts = JSON.parse('@JavaScriptEncoder.Default.Encode(destinationCountsJson)');

        const monthlyCtx = document.getElementById('monthlyExpensesChart');
        const topCtx = document.getElementById('topDestinationsChart');

        new Chart(monthlyCtx, {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'Expenses',
                    data: monthlyTotals,
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });

        new Chart(topCtx, {
            type: 'bar',
            data: {
                labels: destinationLabels,
                datasets: [{
                    label: 'Trips',
                    data: destinationCounts
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                scales: {
                    x: { beginAtZero: true, ticks: { precision: 0 } }
                },
                plugins: { legend: { display: false } }
            }
        });
    </script>
}