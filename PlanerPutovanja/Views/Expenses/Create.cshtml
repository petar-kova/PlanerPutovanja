@model PlanerPutovanja.Models.Expense

@{
    ViewData["Title"] = "Dodaj trošak";
}

<section class="app-hero expense-hero">
    <div class="container">
        <div class="app-hero-content">
            <div>
                <span class="eyebrow">Budžet putovanja</span>
                <h1>Dodaj trošak</h1>
                <p>
                    Unesi trošak smještaja, prijevoza, hrane, ulaznica ili drugih stavki kako bi lakše pratio ukupnu potrošnju.
                </p>
            </div>

            <a asp-controller="Trips"
               asp-action="Details"
               asp-route-id="@Model.TripId"
               class="btn-ghost">
                ← Detalji putovanja
            </a>
        </div>
    </div>
</section>

<section class="section-sm">
    <div class="container">
        <div class="simple-form-layout">
            <div class="simple-form-card">
                <div class="form-heading">
                    <span>💶</span>
                    <div>
                        <h2>Novi trošak</h2>
                        <p>Dodaj naziv, opis i iznos troška. Sve unesene stavke prikazat će se u pregledu putovanja.</p>
                    </div>
                </div>

                <form asp-action="Create" asp-route-tripId="@Model.TripId" method="post">
                    @Html.AntiForgeryToken()

                    <input asp-for="TripId" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Naziv troška</label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="npr. Smještaj, gorivo, večera, ulaznice..." />
                        <span asp-validation-for="Name" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Opis</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="npr. Apartman za 3 noćenja, gorivo do Splita, ulaznice za muzej..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label">Iznos (€)</label>
                        <input asp-for="Amount"
                               class="form-control"
                               placeholder="npr. 120,00" />
                        <span asp-validation-for="Amount" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-main">
                            Spremi trošak
                        </button>

                        <a asp-controller="Trips"
                           asp-action="Details"
                           asp-route-id="@Model.TripId"
                           class="btn-ghost">
                            Odustani
                        </a>
                    </div>
                </form>
            </div>

            <aside class="simple-side-card">
                <div class="side-icon">📊</div>
                <h3>Što možeš pratiti?</h3>
                <p>
                    Troškovi pomažu usporediti stvarnu potrošnju s planiranim budžetom putovanja.
                </p>

                <div class="suggestion-list">
                    <span>🏨 Smještaj</span>
                    <span>🚗 Prijevoz</span>
                    <span>🍽️ Hrana i piće</span>
                    <span>🎟️ Ulaznice i aktivnosti</span>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}