@model PlanerPutovanja.Models.Expense

@{
    ViewData["Title"] = "Uredi trošak";
}

<section class="app-hero expense-hero">
    <div class="container">
        <div class="app-hero-content">
            <div>
                <span class="eyebrow">Uređivanje troška</span>
                <h1>Uredi trošak</h1>
                <p>
                    Ažuriraj naziv, opis ili iznos troška. Promjene će se odmah prikazati u pregledu putovanja.
                </p>
            </div>

            <a asp-controller="Trips"
               asp-action="Details"
               asp-route-id="@Model.TripId"
               class="btn-ghost">
                ← Detalji putovanja
            </a>
        </div>
    </div>
</section>

<section class="section-sm">
    <div class="container">
        <div class="simple-form-layout">
            <div class="simple-form-card">
                <div class="form-heading">
                    <span>✏️</span>
                    <div>
                        <h2>@Model.Name</h2>
                        <p>Uredi podatke troška i spremi promjene u planu putovanja.</p>
                    </div>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="TripId" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Naziv troška</label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="npr. Smještaj, gorivo, večera, ulaznice..." />
                        <span asp-validation-for="Name" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Opis</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Dodaj opis ili napomenu o trošku..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label">Iznos (€)</label>
                        <input asp-for="Amount"
                               class="form-control"
                               placeholder="npr. 120,00" />
                        <span asp-validation-for="Amount" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-main">
                            Spremi promjene
                        </button>

                        <a asp-controller="Trips"
                           asp-action="Details"
                           asp-route-id="@Model.TripId"
                           class="btn-ghost">
                            Odustani
                        </a>
                    </div>
                </form>
            </div>

            <aside class="simple-side-card">
                <div class="side-icon">💡</div>
                <h3>Savjet za budžet</h3>
                <p>
                    Redovitim unosom troškova možeš vidjeti koliko si blizu planiranom budžetu.
                </p>

                <div class="suggestion-list">
                    <span>💳 Plaćanja karticom</span>
                    <span>💵 Gotovina</span>
                    <span>🧾 Računi</span>
                    <span>📌 Neplanirani troškovi</span>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}