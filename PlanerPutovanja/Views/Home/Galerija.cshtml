@{
    ViewData["Title"] = "Galerija";
}

<section class="page-hero gallery-hero">
    <div class="container">
        <div class="page-hero-content text-center">
            <span class="eyebrow">Putnička inspiracija</span>
            <h1>Galerija destinacija i trenutaka s putovanja</h1>
            <p>
                Vizualni prikaz različitih tipova putovanja: more, gradovi, priroda,
                romantični vikendi i aktivni izleti.
            </p>
        </div>
    </div>
</section>

<section class="section-sm">
    <div class="container">
        <div class="gallery-intro text-center">
            <span class="eyebrow">Galerija</span>
            <h2 class="section-title">Putovanje počinje inspiracijom</h2>
            <p class="section-subtitle">
                Galerija koristi responzivni CSS grid raspored. Slike su prikazane u različitim veličinama
                kako bi stranica izgledala dinamično i vizualno zanimljivo.
            </p>
        </div>

        <div class="gallery-grid">
            <div class="gallery-item large" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80');">
                <div class="gallery-caption">
                    <h3>Obala i more</h3>
                    <p>Idealno za ljetni odmor i opuštanje.</p>
                </div>
            </div>

            <div class="gallery-item medium" style="background-image: url('https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?auto=format&fit=crop&w=900&q=80');">
                <div class="gallery-caption">
                    <h3>Romantični gradovi</h3>
                    <p>Mostovi, trgovi i posebna atmosfera.</p>
                </div>
            </div>

            <div class="gallery-item small" style="background-image: url('https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=900&q=80');">
                <div class="gallery-caption">
                    <h3>Planine</h3>
                    <p>Za ljubitelje prirode.</p>
                </div>
            </div>

            <div class="gallery-item small" style="background-image: url('https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=900&q=80');">
                <div class="gallery-caption">
                    <h3>Izleti</h3>
                    <p>Kratka putovanja puna doživljaja.</p>
                </div>
            </div>

            <div class="gallery-item medium" style="background-image: url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=900&q=80');">
                <div class="gallery-caption">
                    <h3>Avantura</h3>
                    <p>Za aktivne i znatiželjne putnike.</p>
                </div>
            </div>

            <div class="gallery-item large" style="background-image: url('https://images.unsplash.com/photo-1555990538-c48b0f0e0f85?auto=format&fit=crop&w=1200&q=80');">
                <div class="gallery-caption">
                    <h3>Povijesni gradovi</h3>
                    <p>Kultura, arhitektura i posebne lokacije.</p>
                </div>
            </div>

            <div class="gallery-item medium" style="background-image: url('https://images.unsplash.com/photo-1605649461784-98f3f8e31b4f?auto=format&fit=crop&w=900&q=80');">
                <div class="gallery-caption">
                    <h3>Mediteran</h3>
                    <p>Hrana, more i opušteni ritam.</p>
                </div>
            </div>

            <div class="gallery-item small" style="background-image: url('https://images.unsplash.com/photo-1565992441121-4367c2967103?auto=format&fit=crop&w=900&q=80');">
                <div class="gallery-caption">
                    <h3>Jezera</h3>
                    <p>Mir, zelenilo i šetnice.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-highlight">
    <div class="container text-center">
        <span class="eyebrow">Vizualni identitet</span>
        <h2 class="section-title">Galerija je dio korisničkog iskustva</h2>
        <p class="section-subtitle">
            Fotografije se koriste kako bi korisnik lakše doživio atmosferu destinacija.
            Svaka slika ima tekstualni opis i hover efekt, čime stranica djeluje življe i profesionalnije.
        </p>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-premium h-100 p-4">
                    <div class="feature-icon">🖼️</div>
                    <h3 class="feature-title">CSS Grid</h3>
                    <p class="feature-text">
                        Galerija koristi mrežni raspored s različitim veličinama elemenata za dinamičan izgled.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-premium h-100 p-4">
                    <div class="feature-icon">✨</div>
                    <h3 class="feature-title">Hover efekt</h3>
                    <p class="feature-text">
                        Prelaskom miša preko slike pojavljuje se opis, što poboljšava interaktivnost.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-premium h-100 p-4">
                    <div class="feature-icon">📱</div>
                    <h3 class="feature-title">Responzivnost</h3>
                    <p class="feature-text">
                        Raspored se prilagođava desktopu, tabletu i mobilnim uređajima.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section cta-section">
    <div class="container text-center">
        <h2>Odaberi destinaciju iz galerije</h2>
        <p>
            Nakon inspiracije kroz slike, pogledaj detalje destinacija i napravi vlastiti plan putovanja.
        </p>

        <div class="hero-actions justify-content-center">
            <a class="btn-main" asp-controller="Home" asp-action="Destinacije">
                Pogledaj destinacije
            </a>

            <a class="btn-ghost" asp-controller="Home" asp-action="Planer">
                Napravi plan
            </a>
        </div>
    </div>
</section>