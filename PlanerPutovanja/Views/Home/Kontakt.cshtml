@{
    ViewData["Title"] = "Kontakt";
}

<section class="contact-3d-hero">
    <div class="contact-orb contact-orb-one"></div>
    <div class="contact-orb contact-orb-two"></div>

    <div class="container">
        <div class="contact-hero-grid">
            <div>
                <span class="eyebrow">Kontakt i podrška</span>
                <h1>Imaš pitanje, ideju ili prijedlog destinacije?</h1>
                <p>
                    Pošalji upit, predloži destinaciju ili ostavi komentar vezan uz planiranje putovanja.
                    Forma provjerava unos i odmah prikazuje potvrdu slanja.
                </p>

                <div class="hero-actions">
                    <a class="btn-main" asp-controller="Trips" asp-action="Create">
                        Kreiraj putovanje
                    </a>

                    <a class="btn-ghost" asp-controller="Home" asp-action="Destinacije">
                        Pogledaj destinacije
                    </a>
                </div>
            </div>

            <div class="contact-floating-board">
                <div class="contact-message-card message-main">
                    <span>Nova poruka</span>
                    <strong>Prijedlog destinacije</strong>
                    <p>“Volio bih dodati putovanje kroz Istru...”</p>
                </div>

                <div class="contact-mini-card contact-mini-one">
                    <strong>24h</strong>
                    <span>odgovor</span>
                </div>

                <div class="contact-mini-card contact-mini-two">
                    <strong>4</strong>
                    <span>teme upita</span>
                </div>

                <div class="contact-support-card">
                    <span>📍</span>
                    <div>
                        <strong>Zagreb</strong>
                        <small>Hrvatska</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-sm contact-3d-section">
    <div class="container">
        <div class="contact-layout-3d">
            <div class="contact-info-3d-card">
                <span class="eyebrow">Informacije</span>
                <h2>Tu smo za sva pitanja</h2>
                <p>
                    Koristi kontakt formu za pitanja o planiranju, budžetu, destinacijama ili za prijedloge poboljšanja aplikacije.
                </p>

                <div class="contact-list premium-contact-list">
                    <div class="contact-list-item">
                        <span>📍</span>
                        <div>
                            <strong>Lokacija</strong>
                            <p>Zagreb, Hrvatska</p>
                        </div>
                    </div>

                    <div class="contact-list-item">
                        <span>✉️</span>
                        <div>
                            <strong>Email</strong>
                            <p>info@planerputovanja.hr</p>
                        </div>
                    </div>

                    <div class="contact-list-item">
                        <span>🕒</span>
                        <div>
                            <strong>Dostupnost</strong>
                            <p>Pon - Pet, 09:00 - 17:00</p>
                        </div>
                    </div>
                </div>

                <div class="contact-map-card">
                    <div class="contact-map-path"></div>
                    <i class="contact-map-dot dot-a"></i>
                    <i class="contact-map-dot dot-b"></i>
                    <i class="contact-map-dot dot-c"></i>

                    <div>
                        <strong>PlanerPutovanja centar</strong>
                        <p>Kontakt točka za upite, prijedloge i ideje.</p>
                    </div>
                </div>
            </div>

            <div class="contact-form-3d-card">
                <div class="contact-form-header">
                    <span class="eyebrow">Pošalji poruku</span>
                    <h2>Kontakt forma</h2>
                    <p>
                        Popuni podatke i odaberi temu upita. Nakon uspješne provjere prikazat će se potvrda.
                    </p>
                </div>

                <form id="contactForm" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="contactName">Ime i prezime</label>
                            <input type="text" class="form-control" id="contactName" placeholder="Unesi ime" />
                            <small class="form-error" id="nameError"></small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="contactEmail">Email adresa</label>
                            <input type="email" class="form-control" id="contactEmail" placeholder="ime@email.com" />
                            <small class="form-error" id="emailError"></small>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="contactSubject">Tema upita</label>
                            <select class="form-select" id="contactSubject">
                                <option value="">Odaberi temu</option>
                                <option value="destinacija">Prijedlog destinacije</option>
                                <option value="planiranje">Pitanje o planiranju</option>
                                <option value="budzet">Pitanje o budžetu</option>
                                <option value="ostalo">Ostalo</option>
                            </select>
                            <small class="form-error" id="subjectError"></small>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="contactMessage">Poruka</label>
                            <textarea class="form-control" id="contactMessage" rows="6" placeholder="Napiši svoju poruku..."></textarea>
                            <small class="form-error" id="messageError"></small>
                        </div>
                    </div>

                    <button type="button" class="btn-main w-100 mt-4" id="sendContactBtn">
                        Pošalji poruku
                    </button>
                </form>

                <div id="contactSuccessMessage" class="success-message contact-success-premium">
                    <strong>Poruka je uspješno pripremljena!</strong>
                    <p>
                        Hvala na javljanju. Tvoj upit je zaprimljen u kontakt formi.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section contact-benefits-section">
    <div class="container text-center">
        <span class="eyebrow">Brza komunikacija</span>
        <h2 class="section-title">Jednostavan način za slanje prijedloga i upita</h2>
        <p class="section-subtitle">
            Kontakt stranica je dio korisničkog iskustva i omogućuje jasnu komunikaciju s korisnikom aplikacije.
        </p>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="contact-benefit-card">
                    <div class="feature-icon">✅</div>
                    <h3>Jasna provjera unosa</h3>
                    <p>Korisnik odmah dobiva poruku ako neko polje nije pravilno popunjeno.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-benefit-card">
                    <div class="feature-icon">📧</div>
                    <h3>Pregledna forma</h3>
                    <p>Forma ima odvojena polja za ime, email, temu i poruku.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-benefit-card">
                    <div class="feature-icon">💬</div>
                    <h3>Potvrda slanja</h3>
                    <p>Nakon uspješnog unosa korisnik dobiva jasnu povratnu informaciju.</p>
                </div>
            </div>
        </div>
    </div>
</section>