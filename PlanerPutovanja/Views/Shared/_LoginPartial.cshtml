@using Microsoft.AspNetCore.Identity
@using PlanerPutovanja.Models

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav align-items-lg-center auth-nav premium-auth-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link user-link premium-user-link"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Moj profil">
                <span class="user-avatar">
                    @((UserManager.GetUserName(User) ?? "K").Substring(0, 1).ToUpper())
                </span>

                <span class="user-name">
                    @UserManager.GetUserName(User)
                </span>
            </a>
        </li>

        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
            <form id="logoutForm"
                  method="post"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="btn btn-logout premium-logout">
                    Odjava
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item me-lg-2 mt-2 mt-lg-0">
            <a class="btn btn-register premium-register"
               asp-area="Identity"
               asp-page="/Account/Register">
                Registracija
            </a>
        </li>

        <li class="nav-item mt-2 mt-lg-0">
            <a class="btn btn-login premium-login"
               asp-area="Identity"
               asp-page="/Account/Login">
                Prijava
            </a>
        </li>
    }
</ul>