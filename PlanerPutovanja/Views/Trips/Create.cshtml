@model PlanerPutovanja.Models.Trip

@{
    ViewData["Title"] = "Create new trip";
}

<h1>Create new trip</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Destination" class="form-label">Primary destination</label>
            <input asp-for="Destination" class="form-control" placeholder="e.g. Split" />
            <span asp-validation-for="Destination" class="text-danger"></span>
            <div class="form-text">Main destination (can add more later)</div>
        </div>

        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Budžet (opcionalno)</label>
            <input name="Budget" class="form-control" type="number" step="0.01" min="0" value="0" />
        </div>



        <div class="col-md-6">
            <label asp-for="Currency" class="form-label"></label>
            <select asp-for="Currency" class="form-select">
                <option value="EUR">EUR (€)</option>
                <option value="USD">USD ($)</option>
                <option value="HRK">HRK (kn)</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="Transport" class="form-label">Transport</label>
            <select asp-for="Transport" class="form-select">
                <option value="0">Not selected</option>
                <option value="1">🚗 Car</option>
                <option value="2">✈️ Plane</option>
                <option value="3">🚂 Train</option>
                <option value="4">🚌 Bus</option>
                <option value="5">🛳️ Cruise ship</option>
                <option value="6">Other</option>
            </select>
        </div>


        <div class="col-md-6">
            <label asp-for="DrivingDistanceKm" class="form-label">Distance (km)</label>
            <input asp-for="DrivingDistanceKm" class="form-control" type="number" placeholder="e.g. 450" />
            <span asp-validation-for="DrivingDistanceKm" class="text-danger"></span>
            <div class="form-text">Only for car trips</div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary me-2">Create trip</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
