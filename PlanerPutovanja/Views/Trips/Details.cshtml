@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.Configuration
@model PlanerPutovanja.Models.Trip
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Detalji putovanja";

    var destinations = Model.Destinations?.OrderBy(d => d.Order).ToList()
                      ?? new List<PlanerPutovanja.Models.TripDestination>();

    var activities = Model.Activities ?? new List<PlanerPutovanja.Models.TripActivity>();
    var expenses = Model.Expenses ?? new List<PlanerPutovanja.Models.Expense>();
    var albums = Model.Albums?
    .OrderByDescending(a => a.CreatedAt)
    .ToList()
    ?? new List<PlanerPutovanja.Models.TripAlbum>();

    var total = expenses.Sum(e => e.Amount);
    decimal? budget = Model.Budget;

    decimal? percentUsedRaw = null;
    decimal? percentUsedWidth = null;

    if (budget.HasValue && budget.Value > 0)
    {
        percentUsedRaw = (total / budget.Value) * 100m;
        percentUsedWidth = Math.Min(100m, percentUsedRaw.Value);
    }

    var tripDays = (Model.EndDate.Date - Model.StartDate.Date).Days + 1;
    if (tripDays < 1) tripDays = 1;

    var costPerDay = tripDays > 0 ? total / tripDays : total;

    var isCarTrip = Model.Transport == PlanerPutovanja.Models.Trip.TransportMode.Car;
    var canCalcRoute = isCarTrip && destinations.Count >= 2;

    var transportIcon = Model.Transport switch
    {
        PlanerPutovanja.Models.Trip.TransportMode.Car => "🚗",
        PlanerPutovanja.Models.Trip.TransportMode.Plane => "✈️",
        PlanerPutovanja.Models.Trip.TransportMode.Train => "🚆",
        PlanerPutovanja.Models.Trip.TransportMode.Bus => "🚌",
        PlanerPutovanja.Models.Trip.TransportMode.CruiseShip => "🛳️",
        _ => "🧭"
    };

    var transportText = Model.Transport switch
    {
        PlanerPutovanja.Models.Trip.TransportMode.Car => "Auto",
        PlanerPutovanja.Models.Trip.TransportMode.Plane => "Avion",
        PlanerPutovanja.Models.Trip.TransportMode.Train => "Vlak",
        PlanerPutovanja.Models.Trip.TransportMode.Bus => "Autobus",
        PlanerPutovanja.Models.Trip.TransportMode.CruiseShip => "Brod",
        _ => "Nije odabrano"
    };

    var today = DateTime.Today;
    var tripStatusText = "Nadolazeće";
    var tripStatusClass = "status-upcoming";

    if (Model.StartDate.Date <= today && Model.EndDate.Date >= today)
    {
        tripStatusText = "U tijeku";
        tripStatusClass = "status-active";
    }
    else if (Model.EndDate.Date < today)
    {
        tripStatusText = "Završeno";
        tripStatusClass = "status-finished";
    }

    var mapsKey = (Configuration["GoogleMaps:ApiKey"] ?? "").Trim();
    var hasMap = !string.IsNullOrWhiteSpace(mapsKey) && destinations.Any();
    var mapsScriptUrl =
        $"https://maps.googleapis.com/maps/api/js?key={Uri.EscapeDataString(mapsKey)}&callback=initMap";

    var locationsJson = JsonSerializer.Serialize(
        destinations
            .Select(d => d.City)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .ToList()
    );

    var weatherByCity = ViewBag.WeatherByCity as IDictionary<string, PlanerPutovanja.Services.WeatherService.WeatherInfo?>;

    var remainingBudget = budget.HasValue ? budget.Value - total : 0m;
    var remainingBudgetText = budget.HasValue
        ? (remainingBudget >= 0
            ? $"{remainingBudget.ToString("0.00", CultureInfo.InvariantCulture)} € preostalo"
            : $"{Math.Abs(remainingBudget).ToString("0.00", CultureInfo.InvariantCulture)} € preko budžeta")
        : "Budžet nije postavljen";

    var budgetStateText = "Bez budžeta";
    var budgetStateClass = "budget-neutral";

    if (budget.HasValue && percentUsedRaw.HasValue)
    {
        if (percentUsedRaw.Value < 70m)
        {
            budgetStateText = "Budžet je pod kontrolom";
            budgetStateClass = "budget-good";
        }
        else if (percentUsedRaw.Value <= 100m)
        {
            budgetStateText = "Približavaš se limitu";
            budgetStateClass = "budget-warn";
        }
        else
        {
            budgetStateText = "Budžet je prekoračen";
            budgetStateClass = "budget-danger";
        }
    }
    var hasDestinationsPlan = destinations.Any();
    var hasRoutePlan = destinations.Count >= 2;
    var hasBudgetPlan = budget.HasValue && budget.Value > 0;
    var hasExpensesPlan = expenses.Any();
    var hasActivitiesPlan = activities.Any();

    var readinessScore = 0;
    if (hasDestinationsPlan) readinessScore += 20;
    if (hasRoutePlan) readinessScore += 20;
    if (hasBudgetPlan) readinessScore += 20;
    if (hasExpensesPlan) readinessScore += 20;
    if (hasActivitiesPlan) readinessScore += 20;

    var readinessText = readinessScore switch
    {
        >= 80 => "Putovanje je odlično pripremljeno",
        >= 50 => "Putovanje je djelomično spremno",
        _ => "Putovanje treba još doraditi"
    };
}

<div class="details-page">

    <section class="details-hero">
        <div class="container">
            <div class="details-hero-content">
                <div class="details-hero-copy">
                    <span class="eyebrow">Travel command</span>
                    <h1>@Model.Name</h1>
                    <p class="details-lead">
                        @Model.Destination
                    </p>

                    <div class="details-hero-meta">
                        <span class="meta-pill">
                            @transportIcon @transportText
                        </span>
                        <span class="meta-pill">
                            📅 @Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")
                        </span>
                        <span class="meta-pill">
                            ⏳ @tripDays dan@(tripDays == 1 ? "" : "a")
                        </span>
                        <span class="meta-pill @tripStatusClass">
                            @tripStatusText
                        </span>
                        @if (budget.HasValue)
                        {
                            <span class="meta-pill accent">
                                💰 @budget.Value.ToString("0.00", CultureInfo.InvariantCulture) €
                            </span>
                        }
                    </div>
                </div>

                <div class="details-actions">
                    <a asp-controller="Trips" asp-action="Index" class="btn-ghost">
                        ← Moja putovanja
                    </a>

                    <a asp-controller="Trips" asp-action="ExportPdf" asp-route-id="@Model.Id" class="btn-ghost">
                        PDF
                    </a>
                    <a asp-controller="Albums" asp-action="Create" asp-route-tripId="@Model.Id" class="btn-main">
                        Dodaj uspomene
                    </a>
                    <a asp-controller="Trips" asp-action="Edit" asp-route-id="@Model.Id" class="btn-main">
                        Uredi putovanje
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="section-sm details-main-section">
        <div class="container">

            <div class="details-stats-grid">
                <div class="details-stat-card">
                    <span>⏳</span>
                    <small>Trajanje</small>
                    <strong>@tripDays</strong>
                    <p>dan@(tripDays == 1 ? "" : "a") putovanja</p>
                </div>

                <div class="details-stat-card">
                    <span>📍</span>
                    <small>Destinacije</small>
                    <strong>@destinations.Count</strong>
                    <p>točk@(destinations.Count == 1 ? "a" : "e") plana</p>
                </div>

                <div class="details-stat-card">
                    <span>🎯</span>
                    <small>Aktivnosti</small>
                    <strong>@activities.Count</strong>
                    <p>planiran@(activities.Count == 1 ? "a" : "ih") aktivnosti</p>
                </div>

                <div class="details-stat-card">
                    <span>💶</span>
                    <small>Troškovi</small>
                    <strong>@total.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                    <p>ukupno uneseno</p>
                </div>

                <div class="details-stat-card">
                    <span>📊</span>
                    <small>Po danu</small>
                    <strong>@costPerDay.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                    <p>prosječni trošak po danu</p>
                </div>
            </div>
            <div class="details-readiness-panel">
                <div class="readiness-main">
                    <div>
                        <span class="eyebrow">Plan spremnosti</span>
                        <h2>@readinessText</h2>
                        <p>
                            Ovaj pregled pokazuje koliko je putovanje pripremljeno kroz destinacije,
                            rutu, budžet, troškove i aktivnosti.
                        </p>
                    </div>

                    <div class="readiness-score">
                        <strong>@readinessScore%</strong>
                        <span>spremno</span>
                    </div>
                </div>

                <div class="readiness-progress">
                    <div style="@($"width: {readinessScore}%;")"></div>
                </div>

                <div class="readiness-grid">
                    <div class="readiness-item @(hasDestinationsPlan ? "done" : "missing")">
                        <span>@(hasDestinationsPlan ? "✅" : "⭕")</span>
                        <div>
                            <strong>Destinacije</strong>
                            <small>@(hasDestinationsPlan ? "Dodane su destinacije." : "Dodaj barem jednu destinaciju.")</small>
                        </div>
                    </div>

                    <div class="readiness-item @(hasRoutePlan ? "done" : "missing")">
                        <span>@(hasRoutePlan ? "✅" : "⭕")</span>
                        <div>
                            <strong>Ruta</strong>
                            <small>@(hasRoutePlan ? "Ruta se može izračunati." : "Dodaj barem dvije destinacije.")</small>
                        </div>
                    </div>

                    <div class="readiness-item @(hasBudgetPlan ? "done" : "missing")">
                        <span>@(hasBudgetPlan ? "✅" : "⭕")</span>
                        <div>
                            <strong>Budžet</strong>
                            <small>@(hasBudgetPlan ? "Budžet je postavljen." : "Postavi budžet putovanja.")</small>
                        </div>
                    </div>

                    <div class="readiness-item @(hasExpensesPlan ? "done" : "missing")">
                        <span>@(hasExpensesPlan ? "✅" : "⭕")</span>
                        <div>
                            <strong>Troškovi</strong>
                            <small>@(hasExpensesPlan ? "Troškovi su uneseni." : "Dodaj barem jedan trošak.")</small>
                        </div>
                    </div>

                    <div class="readiness-item @(hasActivitiesPlan ? "done" : "missing")">
                        <span>@(hasActivitiesPlan ? "✅" : "⭕")</span>
                        <div>
                            <strong>Aktivnosti</strong>
                            <small>@(hasActivitiesPlan ? "Aktivnosti su planirane." : "Dodaj aktivnosti za putovanje.")</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="details-layout">

                <aside class="details-sidebar">

                    <div class="details-panel details-panel-highlight">
                        <div class="panel-title">
                            <span>📌</span>
                            <div>
                                <h2>Brzi pregled</h2>
                                <p>Najvažnije informacije o ovom putovanju.</p>
                            </div>
                        </div>

                        <div class="overview-grid">
                            <div class="overview-item">
                                <small>Prijevoz</small>
                                <strong>@transportIcon @transportText</strong>
                            </div>

                            <div class="overview-item">
                                <small>Početak</small>
                                <strong>@Model.StartDate.ToString("dd.MM.yyyy")</strong>
                            </div>

                            <div class="overview-item">
                                <small>Završetak</small>
                                <strong>@Model.EndDate.ToString("dd.MM.yyyy")</strong>
                            </div>

                            <div class="overview-item">
                                <small>Trošak po danu</small>
                                <strong>@costPerDay.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                            </div>

                            <div class="overview-item">
                                <small>Ukupni troškovi</small>
                                <strong>@total.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                            </div>

                            <div class="overview-item">
                                <small>Budžet</small>
                                <strong>
                                    @(budget.HasValue
                                        ? budget.Value.ToString("0.00", CultureInfo.InvariantCulture) + " €"
                                        : "Nije postavljen")
                                </strong>
                            </div>
                        </div>

                        @if (budget.HasValue && percentUsedRaw.HasValue && percentUsedWidth.HasValue)
                        {
                            var raw = percentUsedRaw.Value;
                            var width = percentUsedWidth.Value;

                            <div class="budget-progress-box premium-budget-box @budgetStateClass">
                                <div class="budget-topline">
                                    <div>
                                        <small>Iskorištenost budžeta</small>
                                        <strong>@(raw.ToString("0.##", CultureInfo.InvariantCulture))%</strong>
                                    </div>
                                    <span>@budgetStateText</span>
                                </div>

                                <div class="premium-progress">
                                    <div style="@($"width: {width.ToString("0.##", CultureInfo.InvariantCulture)}%;")"></div>
                                </div>

                                <p class="budget-remaining-note">@remainingBudgetText</p>
                            </div>
                        }
                    </div>

                    <div class="details-panel">
                        <div class="panel-title">
                            <span>🌤️</span>
                            <div>
                                <h2>Vrijeme</h2>
                                <p>Brzi pregled prognoze po destinacijama.</p>
                            </div>
                        </div>

                        @if (destinations.Count == 0)
                        {
                            <div class="soft-message">
                                Dodaj destinaciju za prikaz vremenske prognoze.
                            </div>
                        }
                        else if (weatherByCity == null || weatherByCity.Count == 0)
                        {
                            <div class="soft-message warning">
                                Trenutno nema dostupnih podataka o vremenu.
                            </div>
                        }
                        else
                        {
                            <div class="weather-stack">
                                @foreach (var d in destinations)
                                {
                                    var city = (d.City ?? "").Trim();
                                    if (string.IsNullOrWhiteSpace(city)) { continue; }

                                    weatherByCity.TryGetValue(city, out var w);

                                    <div class="weather-card-item">
                                        <div class="weather-city">
                                            <strong>@city</strong>
                                            <span>Vremenska prognoza</span>
                                        </div>

                                        @if (w == null)
                                        {
                                            <em>Nema podataka</em>
                                        }
                                        else
                                        {
                                            dynamic wd = w;

                                            <div class="weather-temp">
                                                @(wd?.TemperatureC ?? wd?.Temp ?? wd?.Temperature ?? "?")°C
                                                <small>@(wd?.Description ?? wd?.Summary ?? "")</small>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="details-panel">
                        <div class="panel-title">
                            <span>🛣️</span>
                            <div>
                                <h2>Ruta</h2>
                                <p>Izračun udaljenosti i vremena prema unesenim destinacijama.</p>
                            </div>
                        </div>

                        @if (isCarTrip)
                        {
                            <button id="btnCalcRoute"
                                    class="btn-main w-100"
                                    type="button"
                                    data-trip-id="@Model.Id"
                            @(canCalcRoute ? null : "disabled")>
                                Osvježi rutu
                            </button>

                            <span id="routeLoading" class="route-loading" style="display:none;">
                                Računam rutu...
                            </span>

                            <div id="routeResult" class="route-result"></div>

                            @if (!canCalcRoute)
                            {
                                <div class="soft-message mt-3">
                                    Dodaj barem 2 destinacije za izračun rute.
                                </div>
                            }
                            else
                            {
                                <div class="route-panel-note">
                                    Ruta se računa redoslijedom kojim su destinacije složene.
                                </div>
                            }
                        }
                        else
                        {
                            <div class="soft-message">
                                Izračun rute dostupan je samo za putovanja autom.
                            </div>
                        }
                    </div>

              

                </aside>

                <main class="details-main">

                    <div class="details-panel">
                        <div class="section-panel-header">
                            <div class="panel-title">
                                <span>📍</span>
                                <div>
                                    <h2>Destinacije</h2>
                                    <p>Dodaj, presloži i upravljaj rutom putovanja.</p>
                                </div>
                            </div>

                            <span class="count-pill">@destinations.Count</span>
                        </div>

                        <form asp-controller="TripDestinations" asp-action="Add" method="post" class="add-destination-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tripId" value="@Model.Id" />

                            <input type="text"
                                   name="destination"
                                   class="form-control"
                                   required
                                   maxlength="80"
                                   placeholder="Dodaj destinaciju, npr. Zagreb, Split, Rim..." />

                            <button type="submit" class="btn-main">
                                Dodaj
                            </button>
                        </form>

                        @if (!destinations.Any())
                        {
                            <div class="empty-mini premium-empty">
                                <strong>Nema dodanih destinacija</strong>
                                <p>Dodaj prvu destinaciju i započni slaganje rute putovanja.</p>
                            </div>
                        }
                        else
                        {
                            <div class="destination-timeline">
                                @for (var i = 0; i < destinations.Count; i++)
                                {
                                    var d = destinations[i];
                                    var isFirst = i == 0;
                                    var isLast = i == destinations.Count - 1;

                                    <div class="timeline-item premium-timeline-item">
                                        <div class="timeline-order">@(i + 1)</div>

                                        <div class="timeline-content">
                                            <strong>@d.City</strong>
                                            <span>@(isFirst ? "Početna točka rute" : isLast ? "Zadnja točka rute" : "Usputna destinacija")</span>
                                        </div>

                                        <div class="timeline-actions">
                                            <form asp-controller="TripDestinations" asp-action="MoveUp" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <input type="hidden" name="tripId" value="@Model.Id" />
                                                <button class="mini-btn" title="Pomakni gore" @(isFirst ? "disabled" : null)>↑</button>
                                            </form>

                                            <form asp-controller="TripDestinations" asp-action="MoveDown" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <input type="hidden" name="tripId" value="@Model.Id" />
                                                <button class="mini-btn" title="Pomakni dolje" @(isLast ? "disabled" : null)>↓</button>
                                            </form>

                                            <form asp-controller="TripDestinations" asp-action="Delete" method="post" class="m-0"
                                                  onsubmit="return confirm('Želiš obrisati ovu destinaciju?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <input type="hidden" name="tripId" value="@Model.Id" />
                                                <button class="mini-btn danger" title="Obriši">✕</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="details-panel map-feature-panel">
                        <div class="section-panel-header">
                            <div class="panel-title">
                                <span>🗺️</span>
                                <div>
                                    <h2>Karta putovanja</h2>
                                    <p>Vizualni prikaz svih destinacija i rute putovanja.</p>
                                </div>
                            </div>

                            <span class="count-pill">@destinations.Count</span>
                        </div>

                        @if (hasMap)
                        {
                            <div class="map-shell large">
                                <div class="map-toolbar">
                                    <span>📍 @destinations.Count destinacij@(destinations.Count == 1 ? "a" : "e")</span>
                                    <span>Google Maps</span>
                                </div>

                                <div id="map"
                                     class="premium-map premium-map-large"
                                     data-locations='@Html.Raw(locationsJson)'></div>

                                <div class="map-caption">
                                    Karta prikazuje destinacije i automatski pokušava iscrtati rutu prema redoslijedu putovanja.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="soft-message">
                                Karta trenutno nije dostupna. Provjeri postoji li API ključ i barem jedna destinacija.
                            </div>
                        }
                    </div>
                    <div class="details-panel trip-memories-panel">
                        <div class="section-panel-header">
                            <div class="panel-title">
                                <span>📸</span>
                                <div>
                                    <h2>Uspomene s putovanja</h2>
                                    <p>Albumi, osvrti i slike spremljene za ovo putovanje.</p>
                                </div>
                            </div>

                            <a asp-controller="Albums" asp-action="Create" asp-route-tripId="@Model.Id"
                               class="btn-main btn-small">
                                Dodaj uspomene
                            </a>
                        </div>

                        @if (!albums.Any())
                        {
                            <div class="memory-strip-empty">
                                <div>
                                    <strong>Još nema albuma</strong>
                                    <p>Dodaj osvrt i slike kako bi ovo putovanje dobilo osobni putni dnevnik.</p>
                                </div>

                                <a asp-controller="Albums" asp-action="Create" asp-route-tripId="@Model.Id"
                                   class="btn-ghost">
                                    Kreiraj prvi album
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="trip-memory-strip">
                                @foreach (var album in albums)
                                {
                                    var cover = !string.IsNullOrWhiteSpace(album.CoverImagePath)
                                    ? album.CoverImagePath
                                    : album.Photos?.OrderBy(p => p.DisplayOrder).FirstOrDefault()?.ImagePath;

                                    var rating = new string('★', album.Rating) + new string('☆', 5 - album.Rating);

                                    <a asp-controller="Albums" asp-action="Details" asp-route-id="@album.Id"
                                       class="trip-memory-card">

                                        <div class="trip-memory-cover">
                                            @if (!string.IsNullOrWhiteSpace(cover))
                                            {
                                                <img src="@cover" alt="@album.Title" />
                                            }
                                            else
                                            {
                                                <span>📷</span>
                                            }
                                        </div>

                                        <div class="trip-memory-content">
                                            <small>@album.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                                            <strong>@album.Title</strong>
                                            <span>@rating</span>

                                            <p>
                                                @(string.IsNullOrWhiteSpace(album.Review)
                                                    ? "Album nema dodan osvrt."
                                                    : album.Review.Length > 120
                                                    ? album.Review.Substring(0, 120) + "..."
                                                    : album.Review)
                                            </p>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                    <div class="details-panel">
                        <div class="section-panel-header">
                            <div class="panel-title">
                                <span>🎯</span>
                                <div>
                                    <h2>Aktivnosti</h2>
                                    <p>Izleti, planovi i sve što želiš raditi na putovanju.</p>
                                </div>
                            </div>

                            <a asp-controller="TripActivities" asp-action="Create" asp-route-tripId="@Model.Id"
                               class="btn-main btn-small">
                                Dodaj aktivnost
                            </a>
                        </div>

                        @if (!activities.Any())
                        {
                            <div class="empty-mini premium-empty">
                                <strong>Nema aktivnosti</strong>
                                <p>Dodaj izlete, restorane, razglede ili privatne bilješke za putovanje.</p>
                            </div>
                        }
                        else
                        {
                            <div class="activity-card-grid">
                                @foreach (var a in activities)
                                {
                                    <div class="activity-card">
                                        <div class="activity-card-top">
                                            <span class="activity-icon">🎯</span>

                                            <div class="activity-card-actions">
                                                <a asp-controller="TripActivities" asp-action="Edit" asp-route-id="@a.Id"
                                                   class="mini-link">
                                                    Uredi
                                                </a>

                                                <form asp-controller="TripActivities" asp-action="Delete" asp-route-id="@a.Id"
                                                      method="post" class="m-0" onsubmit="return confirm('Želiš obrisati ovu aktivnost?');">
                                                    @Html.AntiForgeryToken()
                                                    <button class="mini-btn danger">✕</button>
                                                </form>
                                            </div>
                                        </div>

                                        <strong>@a.Name</strong>

                                        @if (!string.IsNullOrWhiteSpace(a.Notes))
                                        {
                                            <p>@a.Notes</p>
                                        }
                                        else
                                        {
                                            <p>Ova aktivnost još nema dodatnih napomena.</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="details-panel">
                        <div class="section-panel-header">
                            <div class="panel-title">
                                <span>💶</span>
                                <div>
                                    <h2>Troškovi</h2>
                                    <p>Pregled svih unesenih troškova ovog putovanja.</p>
                                </div>
                            </div>

                            <a asp-controller="Expenses" asp-action="Create" asp-route-tripId="@Model.Id"
                               class="btn-main btn-small">
                                Dodaj trošak
                            </a>
                        </div>

                        @if (!expenses.Any())
                        {
                            <div class="empty-mini premium-empty">
                                <strong>Nema troškova</strong>
                                <p>Dodaj smještaj, prijevoz, hranu ili ulaznice za bolji pregled budžeta.</p>
                            </div>
                        }
                        else
                        {
                            <div class="expense-card-list">
                                @foreach (var e in expenses.OrderByDescending(x => x.Id))
                                {
                                    <div class="expense-card">
                                        <div class="expense-card-main">
                                            <span class="expense-icon">💶</span>

                                            <div>
                                                <strong>@e.Name</strong>
                                                <span>
                                                    @(!string.IsNullOrWhiteSpace(e.Description)
                                                        ? e.Description
                                                        : "Bez dodatnog opisa")
                                                </span>
                                            </div>
                                        </div>

                                        <div class="expense-card-side">
                                            <em>@e.Amount.ToString("0.00", CultureInfo.InvariantCulture) €</em>

                                            <div class="expense-card-actions">
                                                <a asp-controller="Expenses" asp-action="Edit" asp-route-id="@e.Id"
                                                   class="mini-link">
                                                    Uredi
                                                </a>

                                                <form asp-controller="Expenses" asp-action="Delete" asp-route-id="@e.Id"
                                                      method="post" class="m-0" onsubmit="return confirm('Želiš obrisati ovaj trošak?');">
                                                    @Html.AntiForgeryToken()
                                                    <button class="mini-btn danger">✕</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="expense-summary-box">
                                <div>
                                    <small>Ukupno troškovi</small>
                                    <strong>@total.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                                </div>

                                <div>
                                    <small>Prosjek po danu</small>
                                    <strong>@costPerDay.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                                </div>

                                @if (budget.HasValue)
                                {
                                    <div>
                                        <small>Status budžeta</small>
                                        <strong>@remainingBudgetText</strong>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                </main>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        function formatDuration(minutes) {
            if (!minutes || minutes <= 0) return "0 min";
            const h = Math.floor(minutes / 60);
            const m = minutes % 60;
            return h > 0 ? `${h} h ${m} min` : `${m} min`;
        }

        async function calcRoute(tripId) {
            const loading = document.getElementById("routeLoading");
            const result = document.getElementById("routeResult");
            if (!loading || !result) return;

            loading.style.display = "block";
            result.innerHTML = "";

            try {
                const res = await fetch(`/api/routes/trip/${tripId}/summary`, {
                    credentials: "include"
                });

                const rawText = await res.text();

                let data = null;
                try {
                    data = rawText ? JSON.parse(rawText) : null;
                } catch {
                    data = null;
                }

                if (!res.ok) {
                    const errorMessage =
                        data?.error ||
                        data?.message ||
                        rawText ||
                        `HTTP greška: ${res.status}`;

                    throw new Error(errorMessage);
                }

                const kmValue = data?.totalDistanceKm ?? data?.TotalDistanceKm ?? 0;
                const minsValue = data?.totalDurationMinutes ?? data?.TotalDurationMinutes ?? 0;

                const km = Number(kmValue).toFixed(2);
                const mins = Number(minsValue);

                result.innerHTML = `
                    <div class="route-card-premium">
                        <div class="route-card-icon">
                            <span>🛣️</span>
                        </div>

                        <div class="route-card-content">
                            <div class="route-card-label">Procjena rute</div>

                            <div class="route-card-grid">
                                <div class="route-metric">
                                    <small>Udaljenost</small>
                                    <strong>${km} km</strong>
                                </div>

                                <div class="route-metric">
                                    <small>Trajanje</small>
                                    <strong>${formatDuration(mins)}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } catch (error) {
                result.innerHTML = `
                    <div class="route-card-premium route-card-error">
                        <div class="route-card-icon">
                            <span>⚠️</span>
                        </div>

                        <div class="route-card-content">
                            <div class="route-card-label">Greška rute</div>

                            <div class="route-card-grid">
                                <div class="route-metric single">
                                    <small>Poruka</small>
                                    <strong>${error.message}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                console.error("Route error:", error);
            } finally {
                loading.style.display = "none";
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            const btn = document.getElementById("btnCalcRoute");
            if (btn && !btn.disabled) {
                const tripId = btn.dataset.tripId;
                btn.addEventListener("click", () => calcRoute(tripId));
                calcRoute(tripId);
            }
        });
    </script>

    @if (hasMap)
    {
        <script>
            window.initMap = async function () {
                const mapEl = document.getElementById("map");
                if (!mapEl) return;

                let locations = [];
                try {
                    locations = JSON.parse(mapEl.getAttribute("data-locations") || "[]");
                } catch {
                    locations = [];
                }

                locations = locations
                    .map(x => (x || "").toString().trim())
                    .filter(x => x.length > 0);

                const map = new google.maps.Map(mapEl, {
                    zoom: 6,
                    center: { lat: 45.815, lng: 15.981 },
                    mapTypeControl: false,
                    streetViewControl: false,
                    fullscreenControl: true
                });

                if (locations.length === 0) return;

                const directionsService = new google.maps.DirectionsService();
                const directionsRenderer = new google.maps.DirectionsRenderer({
                    map,
                    suppressMarkers: false
                });

                async function fallbackMarkers() {
                    const geocoder = new google.maps.Geocoder();
                    const bounds = new google.maps.LatLngBounds();
                    let count = 0;

                    for (const city of locations) {
                        try {
                            const res = await geocoder.geocode({ address: city });
                            if (res.results && res.results.length > 0) {
                                const pos = res.results[0].geometry.location;
                                new google.maps.Marker({ map, position: pos, title: city });
                                bounds.extend(pos);
                                count++;
                            }
                        } catch { }
                    }

                    if (count > 1) map.fitBounds(bounds);
                    else if (count === 1) map.setZoom(10);
                }

                if (locations.length === 1) {
                    await fallbackMarkers();
                    return;
                }

                directionsService.route({
                    origin: locations[0],
                    destination: locations[locations.length - 1],
                    waypoints: locations.slice(1, -1).map(c => ({ location: c, stopover: true })),
                    travelMode: google.maps.TravelMode.DRIVING,
                    optimizeWaypoints: false
                }, async (result, status) => {
                    if (status === "OK") directionsRenderer.setDirections(result);
                    else await fallbackMarkers();
                });
            };
        </script>

        <script async defer src="@mapsScriptUrl"></script>
    }
}