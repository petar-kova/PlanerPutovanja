@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.Configuration
@model PlanerPutovanja.Models.Trip
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Detalji putovanja";

    var destinations = Model.Destinations?.OrderBy(d => d.Order).ToList()
                      ?? new List<PlanerPutovanja.Models.TripDestination>();

    var activities = Model.Activities ?? new List<PlanerPutovanja.Models.TripActivity>();
    var expenses = Model.Expenses ?? new List<PlanerPutovanja.Models.Expense>();

    var total = expenses.Sum(e => e.Amount);
    decimal? budget = Model.Budget;

    decimal? percentUsedRaw = null;
    decimal? percentUsedWidth = null;

    if (budget.HasValue && budget.Value > 0)
    {
        percentUsedRaw = (total / budget.Value) * 100m;
        percentUsedWidth = Math.Min(100m, percentUsedRaw.Value);
    }

    var tripDays = (Model.EndDate.Date - Model.StartDate.Date).Days + 1;
    if (tripDays < 1) tripDays = 1;

    var costPerDay = tripDays > 0 ? total / tripDays : total;

    var isCarTrip = Model.Transport == PlanerPutovanja.Models.Trip.TransportMode.Car;
    var canCalcRoute = isCarTrip && destinations.Count >= 2;

    var transportIcon = Model.Transport switch
    {
        PlanerPutovanja.Models.Trip.TransportMode.Car => "🚗",
        PlanerPutovanja.Models.Trip.TransportMode.Plane => "✈️",
        PlanerPutovanja.Models.Trip.TransportMode.Train => "🚆",
        PlanerPutovanja.Models.Trip.TransportMode.Bus => "🚌",
        PlanerPutovanja.Models.Trip.TransportMode.CruiseShip => "🛳️",
        _ => "🧭"
    };

    var transportText = Model.Transport switch
    {
        PlanerPutovanja.Models.Trip.TransportMode.Car => "Auto",
        PlanerPutovanja.Models.Trip.TransportMode.Plane => "Avion",
        PlanerPutovanja.Models.Trip.TransportMode.Train => "Vlak",
        PlanerPutovanja.Models.Trip.TransportMode.Bus => "Autobus",
        PlanerPutovanja.Models.Trip.TransportMode.CruiseShip => "Brod",
        _ => "Nije odabrano"
    };

    var mapsKey = (Configuration["GoogleMaps:ApiKey"] ?? "").Trim();
    var hasMap = !string.IsNullOrWhiteSpace(mapsKey) && destinations.Any();
    var mapsScriptUrl =
        $"https://maps.googleapis.com/maps/api/js?key={Uri.EscapeDataString(mapsKey)}&callback=initMap";

    var locationsJson = JsonSerializer.Serialize(
        destinations
            .Select(d => d.City)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .ToList()
    );

    var firstId = destinations.FirstOrDefault()?.Id ?? 0;
    var lastId = destinations.LastOrDefault()?.Id ?? 0;

    var weatherByCity = ViewBag.WeatherByCity as IDictionary<string, PlanerPutovanja.Services.WeatherService.WeatherInfo?>;
}

<section class="details-hero">
    <div class="container">
        <div class="details-hero-content">
            <div>
                <span class="eyebrow">Detalji plana</span>
                <h1>@Model.Name</h1>
                <p>
                    @Model.Destination
                </p>

                <div class="details-hero-meta">
                    <span>@transportIcon @transportText</span>
                    <span>@Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")</span>
                    <span>@tripDays dan@(tripDays == 1 ? "" : "a")</span>
                </div>
            </div>

            <div class="details-actions">
                <a asp-controller="Trips" asp-action="Index" class="btn-ghost">
                    ← Moja putovanja
                </a>

                <a asp-controller="Trips" asp-action="ExportPdf" asp-route-id="@Model.Id" class="btn-ghost">
                    PDF
                </a>

                <a asp-controller="Trips" asp-action="Edit" asp-route-id="@Model.Id" class="btn-main">
                    Uredi putovanje
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-sm">
    <div class="container">

        <div class="details-stats-grid">
            <div class="details-stat-card">
                <span>Trajanje</span>
                <strong>@tripDays</strong>
                <p>dan@(tripDays == 1 ? "" : "a") putovanja</p>
            </div>

            <div class="details-stat-card">
                <span>Destinacije</span>
                <strong>@destinations.Count</strong>
                <p>točk@(destinations.Count == 1 ? "a" : "e") plana</p>
            </div>

            <div class="details-stat-card">
                <span>Aktivnosti</span>
                <strong>@activities.Count</strong>
                <p>planiran@(activities.Count == 1 ? "a" : "ih") aktivnosti</p>
            </div>

            <div class="details-stat-card">
                <span>Troškovi</span>
                <strong>@total.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                <p>ukupno uneseno</p>
            </div>
        </div>

        <div class="details-layout">
            <aside class="details-sidebar">

                <div class="details-panel">
                    <div class="panel-title">
                        <span>📌</span>
                        <h2>Pregled</h2>
                    </div>

                    <div class="info-list">
                        <div>
                            <span>Prijevoz</span>
                            <strong>@transportIcon @transportText</strong>
                        </div>

                        <div>
                            <span>Početak</span>
                            <strong>@Model.StartDate.ToString("dd.MM.yyyy")</strong>
                        </div>

                        <div>
                            <span>Završetak</span>
                            <strong>@Model.EndDate.ToString("dd.MM.yyyy")</strong>
                        </div>

                        <div>
                            <span>Trošak po danu</span>
                            <strong>@costPerDay.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                        </div>

                        <div>
                            <span>Ukupni troškovi</span>
                            <strong>@total.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                        </div>

                        @if (budget.HasValue)
                        {
                            <div>
                                <span>Budžet</span>
                                <strong>@budget.Value.ToString("0.00", CultureInfo.InvariantCulture) €</strong>
                            </div>
                        }
                    </div>

                    @if (budget.HasValue && percentUsedRaw.HasValue && percentUsedWidth.HasValue)
                    {
                        var raw = percentUsedRaw.Value;
                        var width = percentUsedWidth.Value;

                        <div class="budget-progress-box">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Iskorištenost budžeta</span>
                                <strong>@raw.ToString("0.##", CultureInfo.InvariantCulture)%</strong>
                            </div>

                            <div class="premium-progress">
                                <div style="width:@width.ToString("0.##", CultureInfo.InvariantCulture)%;"></div>
                            </div>
                        </div>
                    }
                </div>

                <div class="details-panel">
                    <div class="panel-title">
                        <span>🌤️</span>
                        <h2>Vrijeme</h2>
                    </div>

                    @if (destinations.Count == 0)
                    {
                        <div class="soft-message">
                            Dodaj destinaciju za prikaz vremenske prognoze.
                        </div>
                    }
                    else if (weatherByCity == null || weatherByCity.Count == 0)
                    {
                        <div class="soft-message warning">
                            Trenutno nema dostupnih podataka o vremenu.
                        </div>
                    }
                    else
                    {
                        <div class="weather-list">
                            @foreach (var d in destinations)
                            {
                                var city = (d.City ?? "").Trim();
                                if (string.IsNullOrWhiteSpace(city)) { continue; }

                                weatherByCity.TryGetValue(city, out var w);

                                <div class="weather-item">
                                    <div>
                                        <strong>@city</strong>
                                        <span>Vremenska prognoza</span>
                                    </div>

                                    @if (w == null)
                                    {
                                        <em>Nema podataka</em>
                                    }
                                    else
                                    {
                                        dynamic wd = w;

                                        <div class="weather-temp">
                                            @(wd?.TemperatureC ?? wd?.Temp ?? wd?.Temperature ?? "?")°C
                                            <small>@(wd?.Description ?? wd?.Summary ?? "")</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="details-panel">
                    <div class="panel-title">
                        <span>🛣️</span>
                        <h2>Ruta</h2>
                    </div>

                    @if (isCarTrip)
                    {
                        <button id="btnCalcRoute"
                                class="btn-main w-100"
                                type="button"
                                data-trip-id="@Model.Id"
                        @(canCalcRoute ? null : "disabled")>
                            Osvježi rutu
                        </button>

                        <span id="routeLoading" class="route-loading" style="display:none;">
                            Računam rutu...
                        </span>

                        <div id="routeResult" class="route-result"></div>

                        @if (!canCalcRoute)
                        {
                            <div class="soft-message mt-3">
                                Dodaj barem 2 destinacije za izračun rute.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="soft-message">
                            Izračun rute dostupan je samo za putovanja autom.
                        </div>
                    }
                </div>

                @if (hasMap)
                {
                    <div class="details-panel">
                        <div class="panel-title">
                            <span>🗺️</span>
                            <h2>Karta</h2>
                        </div>

                        <div id="map"
                             class="premium-map"
                             data-locations='@Html.Raw(locationsJson)'></div>
                    </div>
                }

            </aside>

            <main class="details-main">

                <div class="details-panel">
                    <div class="section-panel-header">
                        <div class="panel-title">
                            <span>📍</span>
                            <h2>Destinacije</h2>
                        </div>
                    </div>

                    <form asp-controller="TripDestinations" asp-action="Add" method="post" class="add-destination-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tripId" value="@Model.Id" />

                        <input type="text"
                               name="destination"
                               class="form-control"
                               required
                               maxlength="80"
                               placeholder="Dodaj destinaciju, npr. Zagreb, Split, Rim..." />

                        <button type="submit" class="btn-main">
                            Dodaj
                        </button>
                    </form>

                    @if (!destinations.Any())
                    {
                        <div class="empty-mini">
                            Nema dodanih destinacija. Dodaj prvu destinaciju za početak planiranja.
                        </div>
                    }
                    else
                    {
                        <div class="destination-timeline">
                            @foreach (var d in destinations)
                            {
                                var isFirst = d.Id == firstId;
                                var isLast = d.Id == lastId;

                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>

                                    <div class="timeline-content">
                                        <strong>@d.City</strong>
                                        <span>Destinacija putovanja</span>
                                    </div>

                                    <div class="timeline-actions">
                                        <form asp-controller="TripDestinations" asp-action="MoveUp" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <input type="hidden" name="tripId" value="@Model.Id" />
                                            <button class="mini-btn" title="Pomakni gore" @(isFirst ? "disabled" : null)>↑</button>
                                        </form>

                                        <form asp-controller="TripDestinations" asp-action="MoveDown" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <input type="hidden" name="tripId" value="@Model.Id" />
                                            <button class="mini-btn" title="Pomakni dolje" @(isLast ? "disabled" : null)>↓</button>
                                        </form>

                                        <form asp-controller="TripDestinations" asp-action="Delete" method="post" class="m-0"
                                              onsubmit="return confirm('Želiš obrisati ovu destinaciju?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <input type="hidden" name="tripId" value="@Model.Id" />
                                            <button class="mini-btn danger" title="Obriši">✕</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="details-panel">
                    <div class="section-panel-header">
                        <div class="panel-title">
                            <span>🎯</span>
                            <h2>Aktivnosti</h2>
                        </div>

                        <a asp-controller="TripActivities" asp-action="Create" asp-route-tripId="@Model.Id"
                           class="btn-main btn-small">
                            Dodaj aktivnost
                        </a>
                    </div>

                    @if (!activities.Any())
                    {
                        <div class="empty-mini">
                            Još nema aktivnosti. Dodaj izlete, obilaske, rezervacije ili planirane događaje.
                        </div>
                    }
                    else
                    {
                        <div class="clean-list">
                            @foreach (var a in activities)
                            {
                                <div class="clean-list-item">
                                    <div>
                                        <strong>@a.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(a.Notes))
                                        {
                                            <span>@a.Notes</span>
                                        }
                                    </div>

                                    <div class="clean-actions">
                                        <a asp-controller="TripActivities" asp-action="Edit" asp-route-id="@a.Id"
                                           class="mini-link">
                                            Uredi
                                        </a>

                                        <form asp-controller="TripActivities" asp-action="Delete" asp-route-id="@a.Id"
                                              method="post" class="m-0" onsubmit="return confirm('Želiš obrisati ovu aktivnost?');">
                                            @Html.AntiForgeryToken()
                                            <button class="mini-btn danger">✕</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="details-panel">
                    <div class="section-panel-header">
                        <div class="panel-title">
                            <span>💶</span>
                            <h2>Troškovi</h2>
                        </div>

                        <a asp-controller="Expenses" asp-action="Create" asp-route-tripId="@Model.Id"
                           class="btn-main btn-small">
                            Dodaj trošak
                        </a>
                    </div>

                    @if (!expenses.Any())
                    {
                        <div class="empty-mini">
                            Još nema troškova. Dodaj smještaj, prijevoz, hranu ili ulaznice.
                        </div>
                    }
                    else
                    {
                        <div class="expense-table-wrap">
                            <table class="premium-table">
                                <thead>
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Opis</th>
                                        <th class="text-end">Iznos</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var e in expenses.OrderByDescending(x => x.Id))
                                    {
                                        <tr>
                                            <td>@e.Name</td>
                                            <td>@e.Description</td>
                                            <td class="text-end">@e.Amount.ToString("0.00", CultureInfo.InvariantCulture) €</td>
                                            <td class="text-end">
                                                <a asp-controller="Expenses" asp-action="Edit" asp-route-id="@e.Id"
                                                   class="mini-link">
                                                    Uredi
                                                </a>

                                                <form asp-controller="Expenses" asp-action="Delete" asp-route-id="@e.Id"
                                                      method="post" class="d-inline" onsubmit="return confirm('Želiš obrisati ovaj trošak?');">
                                                    @Html.AntiForgeryToken()
                                                    <button class="mini-btn danger">✕</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot>
                                    <tr>
                                        <th colspan="2" class="text-end">Ukupno</th>
                                        <th class="text-end">@total.ToString("0.00", CultureInfo.InvariantCulture) €</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

            </main>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function formatDuration(minutes) {
            if (!minutes || minutes <= 0) return "0 min";
            const h = Math.floor(minutes / 60);
            const m = minutes % 60;
            return h > 0 ? `${h} h ${m} min` : `${m} min`;
        }

                async function calcRoute(tripId) {
            const loading = document.getElementById("routeLoading");
            const result = document.getElementById("routeResult");
            if (!loading || !result) return;

            loading.style.display = "block";
            result.innerHTML = "";

            try {
                const res = await fetch(`/api/routes/trip/${tripId}/summary`, {
                    credentials: "include"
                });

                const rawText = await res.text();

                let data = null;
                try {
                    data = rawText ? JSON.parse(rawText) : null;
                } catch {
                    data = null;
                }

                if (!res.ok) {
                    const errorMessage =
                        data?.error ||
                        data?.message ||
                        rawText ||
                        `HTTP greška: ${res.status}`;

                    throw new Error(errorMessage);
                }

                const kmValue = data?.totalDistanceKm ?? data?.TotalDistanceKm ?? 0;
                const minsValue = data?.totalDurationMinutes ?? data?.TotalDurationMinutes ?? 0;

                const km = Number(kmValue).toFixed(2);
                const mins = Number(minsValue);

                result.innerHTML = `
                    <strong>${km} km</strong>
                    <span>${formatDuration(mins)}</span>
                `;
            } catch (error) {
                result.innerHTML = `
                    <strong>Greška rute</strong>
                    <span>${error.message}</span>
                `;

                console.error("Route error:", error);
            } finally {
                loading.style.display = "none";
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            const btn = document.getElementById("btnCalcRoute");
            if (btn && !btn.disabled) {
                const tripId = btn.dataset.tripId;
                btn.addEventListener("click", () => calcRoute(tripId));
                calcRoute(tripId);
            }
        });
    </script>

    @if (hasMap)
    {
        <script>
            window.initMap = async function () {
                const mapEl = document.getElementById("map");
                if (!mapEl) return;

                let locations = [];
                try {
                    locations = JSON.parse(mapEl.getAttribute("data-locations") || "[]");
                } catch {
                    locations = [];
                }

                locations = locations
                    .map(x => (x || "").toString().trim())
                    .filter(x => x.length > 0);

                const map = new google.maps.Map(mapEl, {
                    zoom: 6,
                    center: { lat: 45.815, lng: 15.981 }
                });

                if (locations.length === 0) return;

                const directionsService = new google.maps.DirectionsService();
                const directionsRenderer = new google.maps.DirectionsRenderer({ map, suppressMarkers: false });

                async function fallbackMarkers() {
                    const geocoder = new google.maps.Geocoder();
                    const bounds = new google.maps.LatLngBounds();
                    let count = 0;

                    for (const city of locations) {
                        try {
                            const res = await geocoder.geocode({ address: city });
                            if (res.results && res.results.length > 0) {
                                const pos = res.results[0].geometry.location;
                                new google.maps.Marker({ map, position: pos, title: city });
                                bounds.extend(pos);
                                count++;
                            }
                        } catch { }
                    }

                    if (count > 1) map.fitBounds(bounds);
                    else if (count === 1) map.setZoom(10);
                }

                if (locations.length === 1) {
                    await fallbackMarkers();
                    return;
                }

                directionsService.route({
                    origin: locations[0],
                    destination: locations[locations.length - 1],
                    waypoints: locations.slice(1, -1).map(c => ({ location: c, stopover: true })),
                    travelMode: google.maps.TravelMode.DRIVING,
                    optimizeWaypoints: false
                }, async (result, status) => {
                    if (status === "OK") directionsRenderer.setDirections(result);
                    else await fallbackMarkers();
                });
            };
        </script>

        <script async defer src="@mapsScriptUrl"></script>
    }
}