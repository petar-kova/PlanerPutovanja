@using System.Globalization
@model PlanerPutovanja.Models.Trip

@{
    ViewData["Title"] = "Uredi putovanje";
}

<section class="app-hero edit-trip-hero">
    <div class="container">
        <div class="app-hero-content">
            <div>
                <span class="eyebrow">Uređivanje plana</span>
                <h1>Uredi putovanje</h1>
                <p>
                    Ažuriraj osnovne informacije o putovanju, promijeni datume, budžet ili način prijevoza.
                </p>
            </div>

            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-ghost">
                ← Detalji putovanja
            </a>
        </div>
    </div>
</section>

<section class="section-sm">
    <div class="container">
        <div class="create-trip-layout">
            <div class="create-trip-card">
                <div class="form-heading">
                    <span>02</span>
                    <div>
                        <h2>@Model.Name</h2>
                        <p>Uredi podatke i spremi promjene. Destinacije, aktivnosti i troškovi uređuju se na detaljima putovanja.</p>
                    </div>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="All" class="validation-summary mb-4"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Naziv putovanja</label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="npr. Ljetovanje u Dalmaciji" />
                            <span asp-validation-for="Name" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Destination" class="form-label">Glavna destinacija</label>
                            <input asp-for="Destination"
                                   class="form-control"
                                   placeholder="npr. Split" />
                            <span asp-validation-for="Destination" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">Datum početka</label>
                            <input asp-for="StartDate"
                                   type="text"
                                   class="form-control date-input"
                                   value="@(Model?.StartDate.ToString("dd.MM.yyyy") ?? "")"
                                   placeholder="dd.MM.yyyy"
                                   autocomplete="off" />
                            <span asp-validation-for="StartDate" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label">Datum završetka</label>
                            <input asp-for="EndDate"
                                   type="text"
                                   class="form-control date-input"
                                   value="@(Model?.EndDate.ToString("dd.MM.yyyy") ?? "")"
                                   placeholder="dd.MM.yyyy"
                                   autocomplete="off" />
                            <span asp-validation-for="EndDate" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Budget" class="form-label">Planirani budžet (€)</label>
                            <input name="Budget"
                                   type="text"
                                   class="form-control"
                                   value="@(Model?.Budget?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")"
                                   placeholder="npr. 250,00" />
                            <span asp-validation-for="Budget" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Transport" class="form-label">Način prijevoza</label>
                            <select asp-for="Transport" class="form-select">
                                <option value="">Nije odabrano</option>
                                <option value="1">🚗 Auto</option>
                                <option value="2">✈️ Avion</option>
                                <option value="3">🚆 Vlak</option>
                                <option value="4">🚌 Autobus</option>
                                <option value="5">🛳️ Brod</option>
                                <option value="6">Ostalo</option>
                            </select>
                            <span asp-validation-for="Transport" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-main">
                            Spremi promjene
                        </button>

                        <a asp-action="Details" asp-route-id="@(Model?.Id ?? 0)" class="btn-ghost">
                            Odustani
                        </a>
                    </div>
                </form>
            </div>

            <aside class="create-trip-side">
                <div class="side-card">
                    <div class="side-icon">✏️</div>
                    <h3>Uređuješ postojeći plan</h3>
                    <p>
                        Ovdje mijenjaš osnovne podatke putovanja. Detaljne stavke ostaju spremljene na stranici detalja.
                    </p>
                </div>

                <div class="side-card">
                    <div class="side-icon">📍</div>
                    <h3>Destinacije</h3>
                    <p>
                        Ako želiš dodati, obrisati ili promijeniti redoslijed destinacija, vrati se na detalje putovanja.
                    </p>
                </div>

                <div class="side-card">
                    <div class="side-icon">💶</div>
                    <h3>Troškovi i aktivnosti</h3>
                    <p>
                        Troškove i aktivnosti možeš dodavati kroz detaljni pregled plana.
                    </p>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/i18n/jquery-ui-i18n.min.js"></script>

    <script>
        $(function () {
            if ($.datepicker && $.datepicker.regional && $.datepicker.regional["hr"]) {
                $.datepicker.setDefaults($.datepicker.regional["hr"]);
            }

            $(".date-input").datepicker({
                dateFormat: "dd.mm.yy",
                firstDay: 1
            });
        });
    </script>
}