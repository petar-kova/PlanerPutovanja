@model IEnumerable<PlanerPutovanja.Models.Trip>

@{
    ViewData["Title"] = "Moja putovanja";
    string currentFilter = ViewBag.CurrentFilter as string ?? "all";

    var trips = Model.ToList();
    var totalTrips = trips.Count;
    var upcomingTrips = trips.Count(t => t.StartDate > DateTime.Today);
    var activeTrips = trips.Count(t => t.StartDate <= DateTime.Today && t.EndDate >= DateTime.Today);
    var pastTrips = trips.Count(t => t.EndDate < DateTime.Today);
}

<section class="app-hero">
    <div class="container">
        <div class="app-hero-content">
            <div>
                <span class="eyebrow">Moji planovi</span>
                <h1>Moja putovanja</h1>
                <p>
                    Pregledaj sva svoja putovanja, prati destinacije, aktivnosti, troškove i brzo nastavi s planiranjem.
                </p>
            </div>

            <a asp-action="Create" class="btn-main">
                + Novo putovanje
            </a>
        </div>
    </div>
</section>

<section class="section-sm">
    <div class="container">

        <div class="trip-stats-grid">
            <div class="trip-stat-card">
                <span>Ukupno</span>
                <strong>@totalTrips</strong>
                <p>Sva spremljena putovanja</p>
            </div>

            <div class="trip-stat-card">
                <span>Nadolazeća</span>
                <strong>@upcomingTrips</strong>
                <p>Putovanja koja tek počinju</p>
            </div>

            <div class="trip-stat-card">
                <span>U tijeku</span>
                <strong>@activeTrips</strong>
                <p>Putovanja koja trenutno traju</p>
            </div>

            <div class="trip-stat-card">
                <span>Završena</span>
                <strong>@pastTrips</strong>
                <p>Arhiva prethodnih putovanja</p>
            </div>
        </div>

        @if (!trips.Any())
        {
            <div class="empty-state-card">
                <div class="empty-state-icon">🧳</div>
                <h2>Još nemaš spremljenih putovanja</h2>
                <p>
                    Kreiraj prvo putovanje, dodaj destinacije, aktivnosti i troškove te počni graditi vlastiti plan.
                </p>

                <a asp-action="Create" class="btn-main">
                    Kreiraj prvo putovanje
                </a>
            </div>
        }
        else
        {
            <div class="filter-bar">
                <a asp-action="Index"
                   asp-route-filter="all"
                   class="filter-pill @(currentFilter == "all" ? "active" : "")">
                    Sva putovanja
                </a>

                <a asp-action="Index"
                   asp-route-filter="upcoming"
                   class="filter-pill @(currentFilter == "upcoming" ? "active" : "")">
                    Nadolazeća
                </a>

                <a asp-action="Index"
                   asp-route-filter="current"
                   class="filter-pill @(currentFilter == "current" ? "active" : "")">
                    U tijeku
                </a>

                <a asp-action="Index"
                   asp-route-filter="past"
                   class="filter-pill @(currentFilter == "past" ? "active" : "")">
                    Završena
                </a>
            </div>

            <div class="row g-4">
                @foreach (var trip in trips)
                {
                    var totalDays = (trip.EndDate - trip.StartDate).TotalDays + 1;
                    if (totalDays < 1) totalDays = 1;

                    string status = trip.StartDate > DateTime.Today
                    ? "Nadolazeće"
                    : trip.EndDate < DateTime.Today
                    ? "Završeno"
                    : "U tijeku";

                    string statusClass = trip.StartDate > DateTime.Today
                    ? "status-upcoming"
                    : trip.EndDate < DateTime.Today
                    ? "status-past"
                    : "status-active";

                    var activitiesCount = trip.Activities?.Count() ?? 0;
                    var expensesCount = trip.Expenses?.Count() ?? 0;
                    var destinationsCount = trip.Destinations?.Count() ?? 1;
                    var firstDest = trip.Destinations?.OrderBy(d => d.Order).FirstOrDefault()?.City ?? trip.Destination;

                    string transportText = trip.Transport switch
                    {
                        Trip.TransportMode.Car => "🚗 Auto",
                        Trip.TransportMode.Plane => "✈️ Avion",
                        Trip.TransportMode.Train => "🚆 Vlak",
                        Trip.TransportMode.Bus => "🚌 Autobus",
                        Trip.TransportMode.CruiseShip => "🛳️ Brod",
                        _ => "Prijevoz nije odabran"
                    };

                    <div class="col-md-6 col-xl-4">
                        <div class="trip-card">
                            <div class="trip-card-top">
                                <div>
                                    <span class="trip-status @statusClass">@status</span>
                                    <h2>@trip.Name</h2>
                                </div>

                                <div class="trip-days">
                                    <strong>@totalDays</strong>
                                    <span>dan@(totalDays == 1 ? "" : "a")</span>
                                </div>
                            </div>

                            <div class="trip-location">
                                <span>📍</span>
                                <div>
                                    <strong>@firstDest</strong>
                                    @if (destinationsCount > 1)
                                    {
                                        <small>+ još @(destinationsCount - 1) destinacij@(destinationsCount - 1 == 1 ? "a" : "e")</small>
                                    }
                                    else
                                    {
                                        <small>Glavna destinacija</small>
                                    }
                                </div>
                            </div>

                            <div class="trip-date">
                                @trip.StartDate.ToString("dd.MM.yyyy") - @trip.EndDate.ToString("dd.MM.yyyy")
                            </div>

                            <div class="trip-meta-grid">
                                <div>
                                    <strong>@activitiesCount</strong>
                                    <span>aktivnost@(activitiesCount == 1 ? "" : "i")</span>
                                </div>

                                <div>
                                    <strong>@expensesCount</strong>
                                    <span>troš@(expensesCount == 1 ? "ak" : "kova")</span>
                                </div>
                            </div>

                            <div class="trip-transport">
                                @transportText
                            </div>

                            <div class="trip-actions">
                                <a asp-action="Details" asp-route-id="@trip.Id" class="btn-main btn-card">
                                    Detalji
                                </a>

                                <a asp-action="Edit" asp-route-id="@trip.Id" class="btn-ghost btn-card">
                                    Uredi
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>