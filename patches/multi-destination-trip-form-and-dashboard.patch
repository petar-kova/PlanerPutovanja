+        private static List<TripDestination> BuildDestinations(TripFormViewModel model)
+        {
+            var destinations = model.Destinations
+                .Where(d => !string.IsNullOrWhiteSpace(d.City))
+                .Select((d, index) => new TripDestination
+                {
+                    City = d.City!.Trim(),
+                    Nights = d.Nights,
+                    Order = index + 1
+                })
+                .ToList();
+
+            if (!destinations.Any() && !string.IsNullOrWhiteSpace(model.Destination))
+            {
+                destinations.Add(new TripDestination
+                {
+                    City = model.Destination.Trim(),
+                    Nights = 0,
+                    Order = 1
+                });
+            }
+
+            return destinations;
+        }
+
+        private static void EnsureDestinationRow(TripFormViewModel model)
+        {
+            if (model.Destinations.Count == 0)
+            {
+                model.Destinations.Add(new TripDestinationInput());
+            }
+        }
+
+        private static void NormalizePrimaryDestination(TripFormViewModel model, ModelStateDictionary modelState)
+        {
+            if (!string.IsNullOrWhiteSpace(model.Destination))
+            {
+                return;
+            }
+
+            var firstDestination = model.Destinations.FirstOrDefault(d => !string.IsNullOrWhiteSpace(d.City));
+            if (firstDestination == null)
+            {
+                return;
+            }
+
+            model.Destination = firstDestination.City!.Trim();
+            modelState.Remove(nameof(model.Destination));
+        }
     }
 }
